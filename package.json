{
  "name": "ai-job-intel-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n fe,be -c cyan,magenta \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "backup:db": "node scripts/backup-db.mjs",
    "restore:db": "node scripts/restore-db.mjs",
    "test:api": "node tests/api-smoke.mjs",
    "test:e2e": "node tests/e2e.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
