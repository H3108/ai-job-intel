# 复制本文件为 backend/.env 并填入真实值（backend/.env 已被 .gitignore 忽略，不会提交）
# crawler 内置 pipeline 会自动 loadDotEnv() 读取本文件，因此定时任务无需手动 export。

OPENAI_API_KEY=你的智谱key
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4.6
OPENAI_JSON_MODE=true
OPENAI_CONCURRENCY=3
OPENAI_TIMEOUT_MS=60000
# crawler 内置 pipeline 默认 REQUEST_DELAY_MS=2500（防 429）；如需更保守可在此覆盖。
# 注意：定时（无人值守）运行时建议把 OPENAI_CONCURRENCY 调到 1，降低被限频概率。
